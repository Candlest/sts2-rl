+    <LinkerArg Include="-Wl,--defsym,Sts2Run_GetStateList=Sts2Emulator_Sts2Emulator_Interop_NativeExports__Sts2Run_GetStateList" />
+    <LinkerArg Include="-Wl,--defsym,Sts2Run_GetPhase=Sts2Emulator_Sts2Emulator_Interop_NativeExports__Sts2Run_GetPhase" />

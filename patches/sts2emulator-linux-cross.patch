+    <LinkerArg Include="-Wl,--defsym,Sts2_Step=Sts2Emulator_Sts2Emulator_Interop_NativeExports__Sts2_Step" />
+    <LinkerArg Include="-Wl,--defsym,Sts2_StepTargeted=Sts2Emulator_Sts2Emulator_Interop_NativeExports__Sts2_StepTargeted" />
+    <LinkerArg Include="-Wl,--defsym,Sts2_PlayerWon=Sts2Emulator_Sts2Emulator_Interop_NativeExports__Sts2_PlayerWon" />
+    <LinkerArg Include="-Wl,--defsym,Sts2_EncounterId=Sts2Emulator_Sts2Emulator_Interop_NativeExports__Sts2_EncounterId" />
+    <LinkerArg Include="-Wl,--defsym,Sts2_ActionCount=Sts2Emulator_Sts2Emulator_Interop_NativeExports__Sts2_ActionCount" />
